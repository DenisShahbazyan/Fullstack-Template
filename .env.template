# Базовые значения приложения. app/core/config.py читает этот файл первым,
# а .env.local или .env.docker перекрывают его. Он же — образец для нового
# окружения: секреты здесь — заглушки.
# Переменные инфраструктуры (DOCKER_*, POSTGRES_*, бэкапы) — только в .env.docker.

# ============================================================================
# ПРИЛОЖЕНИЕ (FastAPI)
# DB__HOST превращается в settings.db.host.
# ============================================================================

# SITE — название в заголовках страниц и шапке
SITE__NAME=MyProject
# Часовой пояс посетителей: «сегодня» и время на страницах (app/core/clock.py)
SITE__TIMEZONE=Europe/Moscow

# DATABASE — подключение приложения к Postgres
DB__HOST=localhost
DB__PORT=5432
DB__USERNAME=postgres
DB__PASSWORD=postgres
DB__NAME=myproject_db

# JWT — токены входа
JWT__SECRET=change-me
JWT__ACCESS_TOKEN_LIFETIME_SECONDS=604800
JWT__REFRESH_TOKEN_LIFETIME_SECONDS=604800
JWT__COOKIE_SECURE=false

# CSRF — защита форм
CSRF__SECRET=change-me
CSRF__COOKIE_SECURE=false

# S3 — загрузки сайта. У каждого проекта свой бакет, и локально тоже.
# Ключ и бакет — в .env.local / .env.docker; без них приложение не стартует.
# Размеры и сроки — app/core/config.py.
S3__URL=https://s3.twcstorage.ru
S3__REGION=ru-1
S3__ACCESS_KEY=
S3__SECRET_KEY=
S3__BUCKET_NAME=
