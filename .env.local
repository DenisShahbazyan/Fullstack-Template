# Локальная разработка: приложение на хосте (make dev).
# Читает app/core/config.py поверх .env.template. Postgres — локальный.

# ============================================================================
# ПРИЛОЖЕНИЕ (FastAPI)
# ============================================================================

# SITE — часовой пояс посетителей (app/core/clock.py)
SITE__TIMEZONE=Europe/Moscow

# DATABASE — подключение приложения к Postgres
DB__HOST=localhost
DB__PORT=5432
DB__USERNAME=postgres
DB__PASSWORD=postgres
DB__NAME=myproject_db

# JWT — токены входа
JWT__SECRET=40eeea3dae7207d846718f5751de793738500b22b43ff92dc6f7d58287b56ddf
# Локальная разработка без https
JWT__COOKIE_SECURE=false

# CSRF — защита форм
CSRF__SECRET=ca64ea19569f2d77e68731877ea812928b08a3cc38ddeb005fb23d95dd0152c5
CSRF__COOKIE_SECURE=false

# S3 — свой dev-бакет проекта, не продовый и не чужой: чистка сирот удаляет
# всё, на что не ссылается локальная база. Пустые ключи не дают приложению
# стартовать (app/core/config.py, S3).
S3__ACCESS_KEY=
S3__SECRET_KEY=
S3__BUCKET_NAME=
