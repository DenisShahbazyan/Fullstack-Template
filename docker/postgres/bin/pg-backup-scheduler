#!/bin/sh
# Расписание бэкапов, процесс сервиса backup в docker-compose.yml.
# Раз в сутки (UTC) снимает полный бэкап. После первого бэкапа и по
# воскресеньям проверяет восстановление и целостность репозитория (verify).
# Отметку «сегодня уже было» берёт из самого репозитория, поэтому
# перезапуск при деплое бэкап не повторяет.
# Раз в час смотрит, доходят ли WAL до репозитория: сломанная архивация
# раздувает pg_wal до конца диска, и ждать ночного check — до суток.

set -u

STANZA=main
RETRY_SECONDS=3600
ARCHIVE_CHECK_SECONDS=3600

notify() {
    [ -n "${BACKUP_PING_URL:-}" ] || return 0
    curl -fsS -m 10 --retry 3 -o /dev/null "${BACKUP_PING_URL}$1" || true
}

# Архивация сломана, если последняя неудача позже последнего успеха.
# Успех heartbeat не шлём: он скрыл бы, что сам бэкап не запускается.
check_archiving() {
    failing=$(psql -U "$PGBACKREST_PG1_USER" -d postgres -XAtc "
        SELECT coalesce(last_failed_time > coalesce(last_archived_time, 'epoch'), false)
        FROM pg_stat_archiver") || { notify /fail; return; }
    if [ "$failing" = t ]; then
        echo "WAL не уходят в репозиторий: см. ошибки archive-push в docker logs postgres."
        notify /fail
    fi
}

# Пустой вывод — бэкапов ещё нет. Сбой самого info (S3 не ответил) — код 1:
# принять его за «бэкапов нет» значило бы снять лишний бэкап с полной проверкой.
last_backup_day() {
    info=$(pgbackrest --stanza="$STANZA" --output=json info) || return 1
    stop=$(echo "$info" \
        | jq -r '[.[0].backup[]? | select(.type == "full")] | last | .timestamp.stop // empty')
    [ -z "$stop" ] || date -u -d "@$stop" +%F
}

# verify падает, только если нет WAL, нужного самому бэкапу. Пропавший
# сегмент между бэкапами он показывает лишь как два диапазона WAL одного
# timeline и завершается успешно — такую дыру ищем сами.
verify_repository() {
    out=$(pgbackrest --stanza="$STANZA" --log-level-console=detail verify)
    status=$?
    echo "$out"
    [ "$status" -eq 0 ] || return 1
    echo "$out" | awk '/wal start:/ {
        split($0, a, "archiveId: "); split(a[2], b, ", wal start: ")
        key = b[1] substr(b[2], 1, 8)
        if (key == prev) gap = 1
        prev = key
    } END { exit gap }' && return 0
    echo "В архиве WAL дыра: восстановление на момент внутри неё невозможно."
    return 1
}

# Проверка не прошла — повторяем её со следующим бэкапом, пока не пройдёт:
# иначе завтрашний успешный бэкап погасил бы алерт при негодном восстановлении.
check_pending=

run_backup() {
    pg-backup || { notify /fail; return 1; }
    if [ -z "$1" ] || [ "$(date -u +%u)" = 7 ] || [ -n "$check_pending" ]; then
        check_pending=1
        pg-restore-check || { notify /fail; return 1; }
        # Проверка восстановления берёт только свежий бэкап, verify — все
        # бэкапы и WAL репозитория: пропавший сегмент молча оборвал бы
        # восстановление на момент внутри недели.
        verify_repository || { notify /fail; return 1; }
        check_pending=
    fi
    notify ""
}

if [ -z "${PGBACKREST_REPO1_S3_BUCKET:-}" ]; then
    echo "Раздел BACKUPS в .env.docker не заполнен, бэкапы выключены."
    while :; do sleep 3600; done
fi

until pg_isready -q; do sleep 5; done

until pgbackrest --stanza="$STANZA" stanza-create; do
    notify /fail
    sleep "$RETRY_SECONDS"
done

# Первая проверка — не сразу: после смены хранилища Postgres ещё минуту
# помнит неудачную отправку WAL в репозиторий, где не было stanza.
next_archive_check=$(( $(date +%s) + 300 ))
while :; do
    if [ "$(date +%s)" -ge "$next_archive_check" ]; then
        check_archiving
        next_archive_check=$(( $(date +%s) + ARCHIVE_CHECK_SECONDS ))
    fi
    if last=$(last_backup_day); then
        if [ "$last" != "$(date -u +%F)" ] && ! run_backup "$last"; then
            sleep "$RETRY_SECONDS"
        fi
    fi
    sleep 60
done
