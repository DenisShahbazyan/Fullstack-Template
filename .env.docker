# Продакшен и docker-compose-dev.yml.
# Файл читают двое: docker compose (--env-file .env.docker) подставляет ${...}
# в docker-compose.yml, а env_file отдаёт переменные внутрь контейнеров.
# CI берёт отсюда DOCKER_USERNAME и DOCKER_IMAGE_NAME и копирует файл на сервер.
#
# Файл лежит в git вместе с секретами: репозиторий проекта — приватный.
# Все значения change-me замените до первого деплоя.

# ============================================================================
# ДЕПЛОЙ — CI и docker compose, внутри контейнеров не нужны
# Из них собираются имена образов приложения и Postgres в Docker Hub.
# ============================================================================

# DOCKER HUB
DOCKER_USERNAME=change-me
# Он же — имя каталога проекта на сервере: /home/<SERVER_USER>/<DOCKER_IMAGE_NAME>
# Он же — имя проекта compose (name: в docker-compose.yml), а с ним и volume
# базы: на живом проекте не менять, иначе рядом поднимется пустая база.
DOCKER_IMAGE_NAME=myproject

# ============================================================================
# CADDY — контейнер caddy
# Домен, на который Caddy получает TLS-сертификат ({$DOMAIN} в Caddyfile).
# ============================================================================

# DOMAIN
DOMAIN=example.com

# ============================================================================
# МАСШТАБ — контейнеры web. Меняется коммитом, применяется деплоем.
# У каждого процесса свой пул к Postgres (DB__POOL_SIZE + DB__MAX_OVERFLOW =
# 30), а Postgres по умолчанию держит 100 соединений: пока нет PgBouncer,
# GRANIAN_WORKERS × WEB_REPLICAS (и процессы воркеров, если появятся) — не
# больше 3. На время деплоя web экземпляров вдвое больше: старые работают,
# пока новые стартуют.
# ============================================================================

# Процессов приложения в контейнере web — первый шаг роста, по ядру на процесс
GRANIAN_WORKERS=1
# Контейнеров web: больше одного — смысл на нескольких серверах или ради запаса
WEB_REPLICAS=1

# ============================================================================
# POSTGRES — контейнеры db и backup
# Приложение их не читает, ему нужны DB__* ниже.
# ============================================================================

# DATABASE CREATE (только для создания БД в первый раз)
# Читаются, только когда volume пустой: тогда Postgres создаёт базу и
# пользователя. Поменять их потом можно только в самой базе.
# POSTGRES_USER нужен и backup: под этим пользователем pgBackRest
# подключается к базе (compose передаёт его в PGBACKREST_PG1_USER).
POSTGRES_USER=change-me
POSTGRES_PASSWORD=change-me
POSTGRES_DB=myproject_db

# ============================================================================
# БЭКАПЫ (pgBackRest) — контейнеры db и backup
# db отправляет WAL в S3, backup снимает бэкапы и проверяет восстановление.
# Подробности — docs/guide/ops/backups.md.
# ============================================================================

# BACKUPS
# Отдельный бакет и ключ, не те, что у загрузок сайта.
PGBACKREST_REPO1_S3_ENDPOINT=https://s3.twcstorage.ru
PGBACKREST_REPO1_S3_REGION=ru-1
PGBACKREST_REPO1_S3_BUCKET=
PGBACKREST_REPO1_S3_KEY=
PGBACKREST_REPO1_S3_KEY_SECRET=
# Пароль шифрования бэкапов: openssl rand -base64 48. Потеряется — бэкапы не расшифровать.
PGBACKREST_REPO1_CIPHER_PASS=
# Heartbeat Better Stack (или другого сервиса с адресом «успеха» и URL/fail):
# алерт, если бэкап упал или не запустился.
# Пустой — бэкапы работают, но без алертов.
BACKUP_PING_URL=

# ============================================================================
# КОПИЯ ЗАГРУЗОК (rclone) — контейнер uploads_backup
# Раз в сутки зеркалит бакет S3__* в бакет другого провайдера. Удалённые и
# изменённые файлы хранятся 30 дней. Подробности — docs/guide/ops/uploads-backups.md.
# ============================================================================

# UPLOADS BACKUP
# Пустой UPLOADS_BACKUP_BUCKET — копия выключена.
UPLOADS_BACKUP_BUCKET=
RCLONE_CONFIG_DST_ENDPOINT=
RCLONE_CONFIG_DST_REGION=
RCLONE_CONFIG_DST_ACCESS_KEY_ID=
RCLONE_CONFIG_DST_SECRET_ACCESS_KEY=
# Отдельный heartbeat, не BACKUP_PING_URL: иначе успех бэкапа БД скроет сбой копии.
UPLOADS_BACKUP_PING_URL=
# Потолок удалений из копии за сутки, пусто — 5000. Больше — сбой и алерт, а не
# перенос полбакета в архив. Поднять на один деплой, если массовая чистка законна.
UPLOADS_BACKUP_MAX_DELETE=

# ============================================================================
# ПРИЛОЖЕНИЕ (FastAPI) — контейнеры web, migrate и uploads_sweep
# Читает app/core/config.py: DB__HOST превращается в settings.db.host.
# Значения по умолчанию лежат в .env.template, этот файл их перекрывает.
# ============================================================================

# ENVIRONMENT — docker: настройки берутся из этого файла, а не из .env.local
ENVIRONMENT=docker

# SITE — название в заголовках страниц и шапке
SITE__NAME=MyProject
# Часовой пояс посетителей: «сегодня» и время на страницах (app/core/clock.py)
SITE__TIMEZONE=Europe/Moscow

# DATABASE — подключение приложения к Postgres
# migrate.sh по этим же переменным ждёт, пока база поднимется.
# Совпадают с POSTGRES_* выше: приложение ходит под тем же пользователем.
DB__HOST=db
DB__PORT=5432
DB__USERNAME=change-me
DB__PASSWORD=change-me
DB__NAME=myproject_db

# JWT — токены входа. Секрет: openssl rand -base64 48
JWT__SECRET=change-me
JWT__ACCESS_TOKEN_LIFETIME_SECONDS=604800
JWT__REFRESH_TOKEN_LIFETIME_SECONDS=604800
JWT__COOKIE_SECURE=true

# CSRF — защита форм. Секрет: openssl rand -base64 48
CSRF__SECRET=change-me
CSRF__COOKIE_SECURE=true

# S3 — загрузки сайта. Свой бакет у проекта, отдельный ключ — не тот, что у
# бэкапов. Нужен и uploads_backup: compose подставляет S3__* в его rclone.
S3__URL=https://s3.twcstorage.ru
S3__REGION=ru-1
S3__ACCESS_KEY=
S3__SECRET_KEY=
S3__BUCKET_NAME=
