# Адрес с www — на основной: одна страница не живёт под двумя адресами.
# Сертификат на www Caddy получит, только если у www есть DNS-запись;
# без неё основной домен работает, а в логе — ошибки выпуска сертификата.
# Все экземпляры web (WEB_REPLICAS): Caddy спрашивает DNS Docker каждые
# 5 секунд, новый экземпляр начинает получать запросы сам. Остановленный при
# деплое ещё до 5 секунд в списке: короткий dial_timeout и повтор на другой
# экземпляр, а fail_duration убирает его из выбора — запрос не теряется.
(web_upstreams) {
    dynamic a web 8000 {
        refresh 5s
    }
    lb_policy round_robin
    lb_try_duration 5s
    fail_duration 30s
    transport http {
        dial_timeout 1s
    }
}

www.{$DOMAIN} {
    redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
    # Тело запроса режем до приложения: Starlette принимает multipart целиком,
    # и только потом read_upload сверяет MAX_UPLOAD_BYTES (20 МБ). Без этой
    # границы один запрос на гигабайты забьёт диск контейнера.
    request_body {
        max_size 25MB
    }

    # Лимиты на IP клиента. Вход и регистрация — жёстче всего: это то, что
    # перебирают. В приложении своего ограничителя нет (нет Redis), поэтому
    # граница здесь.
    rate_limit {
        zone general {
            key {remote_host}
            events 300
            window 1m
        }
        zone api {
            key {remote_host}
            events 120
            window 1m
            match {
                path /api/public/v1/*
            }
        }
        zone auth {
            key {remote_host}
            events 10
            window 1m
            match {
                method POST
                path /login /login/submit /register/submit /api/public/v1/auth/*
            }
        }
        # Каждая загрузка — файл в S3 до ночной чистки сирот.
        zone upload {
            key {remote_host}
            events 20
            window 10m
            match {
                method POST
                path /api/public/v1/files/upload
            }
        }
    }

    # HTML страниц сжимается в разы; картинки и так сжаты, их Caddy не трогает.
    encode zstd gzip

    # Заголовки безопасности. CSP: Alpine вычисляет выражения через Function —
    # без 'unsafe-eval' он не работает; inline-скрипт в base.html и style от
    # htmx требуют 'unsafe-inline'; фото — подписанные ссылки на S3__URL
    # (бакет приватный, адресация path-style), превью до загрузки — blob:
    # (gallery-upload.js). Новый внешний источник (карта,
    # видео, счётчик) — дописать сюда, иначе браузер его молча заблокирует.
    # HSTS без includeSubDomains: на поддоменах может жить что-то без https.
    header {
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: {$S3__URL}; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        X-Frame-Options DENY
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=31536000"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }

    reverse_proxy {
        import web_upstreams
    }
}
